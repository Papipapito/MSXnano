IO_LOC  "sd_dat3" 81;
IO_PORT "sd_dat3" IO_TYPE=LVCMOS33;

//wifi (ESP-01S): tx=27, rx=28 -> dos pines CONSECUTIVOS y libres para un solo
//conector (v1.7.2; antes rx=77/tx=73). Zona 26-32 libre (25=ws2812, 33+=HDMI)
IO_LOC "uart_rx" 28;
IO_PORT "uart_rx" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "uart_tx" 27;
IO_PORT "uart_tx"  IO_TYPE=LVCMOS33;

//turbo status -> ESP32-C6 (pin libre zona 26-32): indicador de turbo en la pantalla del ESP
IO_LOC "turbo_status" 29;
//PULL_MODE=DOWN: durante la config del FPGA el pin queda firme en LOW (con el pulldown
//del GPIO3 del ESP) -> sin falso destello "TURBO" al encender en frio. En operacion es
//push-pull, el pull interno es irrelevante.
IO_PORT "turbo_status" PULL_MODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;

//RP2040 (Pico Zero) companion teclado/joystick USB — firmware MSXgoauldSD v1.3.
//Cablear: Pico GP15 (PIO-UART TX, 115200 8N1) -> FPGA pin 31 ; GND comun ; Pico VBUS<-5V.
//(pin FPGA libre zona 26-32; 30 reservado). PULL_MODE=UP = reposo alto sin Pico.
IO_LOC "kbd_uart_rx_pin" 31;
IO_PORT "kbd_uart_rx_pin" PULL_MODE=UP IO_TYPE=LVCMOS33;

