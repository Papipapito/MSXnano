// hw buttons
IO_LOC "KEY[0]" 88; // S1
IO_PORT "KEY[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "KEY[1]" 87; // S2
IO_PORT "KEY[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// SD card
IO_LOC "SD_MOSI" 82;
IO_PORT "SD_MOSI" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "SD_SCK" 83;
IO_PORT "SD_SCK" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "SD_nCS" 81;
IO_PORT "SD_nCS" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "SD_MISO" 84;
IO_PORT "SD_MISO" IO_TYPE=LVCMOS33 PULL_MODE=NONE;


