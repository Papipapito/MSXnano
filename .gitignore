fpga/src/rom/goauld_rom_japan.bin
fpga/src/rom/goauld_rom_int_menu.bin
fpga/src/rom/goauld_rom_int_SDTEST.bin
fpga/src/rom/fm_logo_menu.bin

# Boot-menu build temporaries / logs
fpga/src/msxnano_menu/~tmppre.*
fpga/autofire_build.log

# Settings/boot menu ROM: host build tools (binaries) + build outputs
fpga/src/msxnano_menu/bin/
fpga/src/msxnano_menu/out/
_menu_shot*.png

# Ruflo / ruvector tool databases (regenerable, not project files)
ruvector.db
**/ruvector.db

# Dead earlier experiment (NANOROM) + its copyrighted test ROMs / DOS system
# files (Konami ROMs, MSXDOS2.SYS, COMMAND2.COM) — NOT redistributed.
fpga/src/nanorom/

# Stray FPGA bitstream build outputs left in the source tree
fpga/src/rom/*.fs

# Local design / scratch notes (kept on disk, not tracked)
fpga/src/msxnano_menu/M2_DESIGN.md
fpga/src/msxnano_menu/src/*.SDwork.txt
fpga/midi_build.log

# BIOS packs con Nextor 2.1.4 y ROMs de trabajo (copyright / build local, el
# usuario los genera y sube manualmente). Norma: los .bin del pack se generan
# con Nextor 2.1.4 (no 2.1.1).
fpga/src/rom/goauld_rom_*_n214.bin
fpga/src/rom/Nextor-2.1.4.WonderTANG.ROM.bin
fpga/src/rom/pack_*.bin
fpga/src/rom/msxnano_v*.fs
fpga/src/rom/*_diag*.bin
